{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/task.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:catchall(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/task.js": {
      "runtime": "@vercel/node"
    }
  }
}
