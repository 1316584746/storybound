{
  "functions": {
    "api/task.js": {
      "runtime": "@vercel/node"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/task.js"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:any*",
      "destination": "/index.html"
    }
  ]
}
